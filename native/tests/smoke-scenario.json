{
  "sessions": [
    {
      "open": {
        "commandName": "paste-as-plain-text",
        "preferences": {},
        "argumentValues": {
          "advancedPasteFormat": "Markdown Link"
        }
      },
      "replies": [
        {
          "method": "host.window.visibility",
          "params": {
            "visible": false
          },
          "result": null
        },
        {
          "method": "host.clipboard.read",
          "params": {
            "format": "text"
          },
          "result": "  not a url  "
        },
        {
          "method": "host.clipboard.pasteText",
          "params": {
            "text": "not a url"
          },
          "result": {
            "ok": true
          }
        }
      ],
      "expect": {
        "result": {
          "ok": true,
          "mode": "no-view",
          "message": "📋 Paste as Plain Text"
        }
      },
      "calls": [
        {
          "operation": "extension:refresh-session",
          "expect": {
            "result": {
              "ok": true,
              "mode": "unchanged"
            }
          }
        },
        {
          "operation": "extension:invoke-action",
          "payload": {
            "actionId": "paste"
          },
          "expect": {
            "error": "This no-view command has no bound actions"
          }
        }
      ]
    },
